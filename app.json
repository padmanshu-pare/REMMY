{
  "expo": {
    "name": "REMMY",
    "slug": "remmy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/remmy-logo.png",
    "scheme": "remmy",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#100D0E",
        "foregroundImage": "./assets/images/remmy-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/remmy-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100D0E",
          "image": "./assets/images/remmy-logo.png",
          "imageWidth": 240
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
